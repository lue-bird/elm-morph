{
    "type": "package",
    "name": "lue-bird/elm-morph",
    "summary": "a parser-printer: dev-friendly, general-purpose, great errors",
    "license": "MIT",
    "version": "3.0.1",
    "exposed-modules": [
        "Morph",
        "Maybe.Morph",
        "Result.Morph",
        "Char.Morph",
        "Bit.Morph",
        "AToZ",
        "AToZ.Morph",
        "Sign",
        "Sign.Morph",
        "Int.Morph",
        "Float.Morph",
        "String.Morph",
        "List.Morph",
        "Array.Morph",
        "Set.Morph",
        "Dict.Morph",
        "Value",
        "Value.Morph",
        "Json",
        "Json.Morph"
    ],
    "elm-version": "0.19.1 <= v < 0.20.0",
    "dependencies": {
        "elm/bytes": "1.0.8 <= v < 2.0.0",
        "elm/core": "1.0.5 <= v < 2.0.0",
        "elm/json": "1.1.3 <= v < 2.0.0",
        "lue-bird/elm-bits": "10.1.1 <= v < 11.0.0",
        "lue-bird/elm-linear-direction": "11.2.0 <= v < 12.0.0",
        "lue-bird/elm-no-record-type-alias-constructor-function": "1.0.0 <= v < 2.0.0",
        "lue-bird/elm-partial-or-complete": "1.0.1 <= v < 2.0.0",
        "miniBill/elm-rope": "1.0.0 <= v < 2.0.0",
        "zwilias/elm-rosetree": "1.5.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.1.0 <= v < 3.0.0",
        "turboMaCk/non-empty-list-alias": "1.3.1 <= v < 2.0.0"
    }
}
